{
  "name": "shortlist-gha",
  "version": "1.0.0",
  "private": true,
  "description": "Firefox and Chrome extension: private per-user favorites and a filter for the GitHub Actions sidebar.",
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "icons": "python3 tools/make_icons.py",
    "package": "bash tools/package.sh",
    "lint:firefox": "npx --yes web-ext lint --source-dir .",
    "verify:pagination": "node tools/verify-pagination.mjs",
    "screenshot": "node tools/screenshot.mjs",
    "verify:sidebar": "node tools/verify-sidebar.mjs"
  },
  "license": "MIT",
  "homepage": "https://github.com/nealmanaktola/shortlist-gha",
  "author": "Neal Manaktola"
}
